{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "Verify Digest",
  "mainBinaryName": "Verify Digest",
  "version": "0.2.0",
  "identifier": "verify-digest.psobolik",
  "plugins": {},
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "decorations": false,
        "title": "Verify Digest",
        "width": 700,
        "height": 550,
        "minWidth": 550,
        "minHeight": 550,
        "useHttpsScheme": true
      }
    ]
  }
}